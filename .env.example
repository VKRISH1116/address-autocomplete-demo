# Copy this file to .env.local (never commit .env.local) and fill in what you have.
# With nothing set, the demo runs on built-in sample data.

# Suggestions while typing: mock | google
ADDRESS_PROVIDER=mock

# Address check on Save: mock | google | usps
# (defaults to google when ADDRESS_PROVIDER=google, otherwise mock)
VALIDATOR=mock

# Google Maps Platform key with "Places API (New)" and "Address Validation API" enabled.
# Restrict it to those two APIs in the Google Cloud console.
GOOGLE_MAPS_API_KEY=

# USPS Addresses API v3 (free account at https://developers.usps.com)
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
# Optional: USPS test environment instead of production
# USPS_API_BASE=https://apis-tem.usps.com
